<% if @page == 1 %>
<div class="mb-8 min-w-full flex items-start gap-4">
    <div class="flex-grow">
        <%= render "shared/search_form", path: current_authors_path, placeholder: t(".search_placeholder"), turbo_frame: "authors" %>
    </div>

    <div class="shrink-0 py-5 sm:py-6">
        <%= render "shared/view_toggle" %>
    </div>
</div>
<% end %>

<%= render layout: "shared/paginated_list", locals: { name: "authors" } do %>
    <% if @view_mode == "list" %>
        <%= render "authors/authors_rows", authors: @authors, previews: @previews %>
    <% else %>
        <%= render "authors/authors_list", authors: @authors, previews: @previews %>
    <% end %>
<% end %>
